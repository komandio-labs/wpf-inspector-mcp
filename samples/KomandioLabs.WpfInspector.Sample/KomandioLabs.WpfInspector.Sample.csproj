<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KomandioLabs.WpfInspector.Sample</RootNamespace>
    <AssemblyName>KomandioLabs.WpfInspector.Sample</AssemblyName>
    <AssemblyTitle>Komandio Labs WPF Inspector Sample</AssemblyTitle>
    <Authors>Komandio Labs</Authors>
    <Company>Komandio Labs</Company>
    <Product>Komandio Labs WPF Inspector MCP</Product>
    <Description>Sample WPF application for exercising Komandio Labs WPF Inspector MCP.</Description>
    <Copyright>Copyright © 2026 Komandio Labs</Copyright>
    <RepositoryUrl>https://github.com/komandio-labs/wpf-inspector-mcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
