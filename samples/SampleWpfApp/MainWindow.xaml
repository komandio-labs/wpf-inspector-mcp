<ui:FluentWindow x:Class="SampleWpfApp.MainWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:SampleWpfApp"
                  Title="Sample Complex WPF-UI Application"
                  Height="720" Width="1100"
                  WindowStartupLocation="CenterScreen"
                  ExtendsContentIntoTitleBar="True"
                  WindowBackdropType="Mica"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom WPF-UI TitleBar -->
        <ui:TitleBar x:Name="SampleTitleBar" AutomationProperties.AutomationId="SampleTitleBar" Grid.Row="0" Title="Sample Complex WPF-UI Application" Icon="{ui:SymbolIcon AppFolder24}"/>

        <!-- Main Canvas Grid with Navigation & Page Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation Bar -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="WPF INSPECTOR DEMO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorBrush}" Margin="8,0,0,16"/>

                    <ui:Button x:Name="NavDashboardBtn" AutomationProperties.AutomationId="NavDashboardBtn" Content="📊 Dashboard &amp; Analytics" Appearance="Primary" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="NavDashboard_Click"/>
                    <ui:Button x:Name="NavCollectionBtn" AutomationProperties.AutomationId="NavCollectionBtn" Content="📚 Project Collection" Appearance="Secondary" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="NavCollection_Click"/>
                    <ui:Button x:Name="NavSettingsBtn" AutomationProperties.AutomationId="NavSettingsBtn" Content="⚙️ Settings &amp; Configuration" Appearance="Secondary" Height="38" HorizontalAlignment="Stretch" Margin="0,0,0,16" Click="NavSettings_Click"/>

                    <Separator Margin="0,0,0,16"/>

                    <TextBlock Text="MODAL CONTROLS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8,0,0,8"/>
                    <ui:Button x:Name="OpenModalBtn" AutomationProperties.AutomationId="OpenModalBtn" Content="⚡ Open Test Modal" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="OpenModal_Click"/>
                    <ui:Button x:Name="OpenDrawerBtn" AutomationProperties.AutomationId="OpenDrawerBtn" Content="📜 Open History Drawer" Appearance="Secondary" Height="36" HorizontalAlignment="Stretch" Click="OpenDrawer_Click"/>
                </StackPanel>
            </Border>

            <!-- Content Area View Hosts -->
            <Border Grid.Column="1" Padding="24">
                <Grid>
                    <!-- View 1: Dashboard View -->
                    <Grid x:Name="DashboardView" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="System Analytics &amp; Telemetry" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <ui:Card Grid.Column="0">
                                <Border Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Active Processes" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="12 Active" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <ui:ProgressRing x:Name="ActiveProgressRing" AutomationProperties.AutomationId="ActiveProgressRing" Progress="75" IsIndeterminate="False" Height="40" Width="40" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ui:Card>

                            <ui:Card Grid.Column="2">
                                <Border Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Memory Load" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="4.2 GB / 16 GB" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                        <ProgressBar x:Name="MemoryProgress" AutomationProperties.AutomationId="MemoryProgress" Minimum="0" Maximum="100" Value="35" Height="8" Margin="0,16,0,0"/>
                                    </StackPanel>
                                </Border>
                            </ui:Card>

                            <ui:Card Grid.Column="4">
                                <Border Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="Workspace Mode" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="FOCUS MODE ACTIVE" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0"/>
                                        <ui:Button x:Name="ToggleHighlightButton" AutomationProperties.AutomationId="ToggleHighlightButton" Content="Toggle Highlight" Appearance="Secondary" Height="30" Margin="0,12,0,0" Click="ToggleOverride_Click"/>
                                    </StackPanel>
                                </Border>
                            </ui:Card>
                        </Grid>

                        <!-- Interactive Control Panel -->
                        <ui:Card Grid.Row="2">
                            <Border Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Interaction Controls" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Enable compact mode:" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <ui:ToggleSwitch x:Name="PerfToggle" AutomationProperties.AutomationId="PerfToggle" IsChecked="True"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Refresh interval:" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        <Slider x:Name="SpeedSlider" AutomationProperties.AutomationId="SpeedSlider" Minimum="10" Maximum="240" Value="60" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SpeedReadout" AutomationProperties.AutomationId="SpeedReadout" Text="{Binding ElementName=SpeedSlider, Path=Value, StringFormat={}{0:F0} Hz}" VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="Bold"/>
                                    </StackPanel>

                                    <TextBlock x:Name="StatusLabel" AutomationProperties.AutomationId="StatusLabel" Text="Status: Operational" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                </StackPanel>
                            </Border>
                        </ui:Card>
                    </Grid>

                <!-- View 2: Project Collection View -->
                <Grid x:Name="CollectionView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Collection Workspace" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                    <ListView Grid.Row="1" x:Name="CollectionListView" AutomationProperties.AutomationId="CollectionListView" Background="Transparent" BorderThickness="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ui:Card Margin="0,0,0,8" Padding="14" Background="#FF2B2B2B" BorderBrush="#FF3E3E3E">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F5"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#FFBDBDBD" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <ui:Button Grid.Column="1" AutomationProperties.AutomationId="{Binding ActionId}" Content="Open Record" Appearance="Primary" Height="32" Click="OpenRecord_Click"/>
                                    </Grid>
                                </ui:Card>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- View 3: Settings View -->
                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Application Settings" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
                        <ui:TextBox x:Name="SampleTextInput" AutomationProperties.AutomationId="SampleTextInput" PlaceholderText="Enter a sample value..." Height="38" Margin="0,0,0,16"/>
                        <ComboBox x:Name="ModeSelector" AutomationProperties.AutomationId="ModeSelector" SelectedIndex="0" Margin="0,0,0,16">
                            <ComboBoxItem Content="Balanced"/>
                            <ComboBoxItem Content="Performance"/>
                        </ComboBox>
                        <DatePicker x:Name="MaintenanceDate" AutomationProperties.AutomationId="MaintenanceDate" SelectedDate="2026-08-01" Margin="0,0,0,16"/>
                        <TreeView x:Name="DiagnosticsTree" AutomationProperties.AutomationId="DiagnosticsTree" Margin="0,0,0,16">
                            <TreeViewItem Header="Diagnostics" AutomationProperties.AutomationId="DiagnosticsRoot" IsExpanded="False">
                                <TreeViewItem Header="Network"/>
                            </TreeViewItem>
                        </TreeView>
                        <CheckBox x:Name="VisualLoggingCheck" AutomationProperties.AutomationId="VisualLoggingCheck" Content="Enable Advanced Visual Tree Logging" IsChecked="True" Margin="0,0,0,12"/>
                        <CheckBox x:Name="HardwareAccelerationCheck" AutomationProperties.AutomationId="HardwareAccelerationCheck" Content="Hardware Acceleration Enabled" IsChecked="True" Margin="0,0,0,16"/>
                        <ui:Button x:Name="SaveSettingsButton" AutomationProperties.AutomationId="SaveSettingsButton" Content="Save Settings" Appearance="Primary" Height="36" Width="140" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                        <Separator Margin="0,20,0,16"/>
                        <TextBlock Text="Inspector Control Laboratory" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBox x:Name="NameInput" AutomationProperties.AutomationId="NameInput" Text="Ada Lovelace" Margin="0,0,0,8"/>
                        <TextBox x:Name="NotesInput" AutomationProperties.AutomationId="NotesInput" AcceptsReturn="True" TextWrapping="Wrap" Height="70" Text="Line one" Margin="0,0,0,8"/>
                        <TextBox x:Name="RequiredInput" AutomationProperties.AutomationId="RequiredInput" Margin="0,0,0,8">
                            <TextBox.Text>
                                <Binding Path="RequiredValue" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <local:RequiredTextRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <PasswordBox x:Name="SecretInput" AutomationProperties.AutomationId="SecretInput" Password="initial-secret" Margin="0,0,0,12"/>
                        <ListBox x:Name="ProfileList" AutomationProperties.AutomationId="ProfileList" Height="84" SelectedIndex="0" Margin="0,0,0,8"><ListBoxItem Content="Explorer"/><ListBoxItem Content="Builder"/><ListBoxItem Content="Observer"/></ListBox>
                        <TabControl x:Name="WorkspaceTabs" AutomationProperties.AutomationId="WorkspaceTabs" SelectedIndex="0" Margin="0,0,0,8"><TabItem Header="Overview"><TextBlock Text="Overview tab content" Margin="12"/></TabItem><TabItem Header="Telemetry"><TextBlock Text="Telemetry tab content" Margin="12"/></TabItem></TabControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><RadioButton x:Name="RadioAlpha" AutomationProperties.AutomationId="RadioAlpha" GroupName="SampleRadio" Content="Alpha" IsChecked="True" Margin="0,0,16,0"/><RadioButton x:Name="RadioBeta" AutomationProperties.AutomationId="RadioBeta" GroupName="SampleRadio" Content="Beta"/></StackPanel>
                        <ProgressBar x:Name="TaskProgress" AutomationProperties.AutomationId="TaskProgress" Minimum="0" Maximum="100" Value="64" Height="12" Margin="0,0,0,8"/>
                        <Slider x:Name="VolumeSlider" AutomationProperties.AutomationId="VolumeSlider" Minimum="0" Maximum="100" Value="30" Margin="0,0,0,8"/>
                        <CheckBox x:Name="TriStateCheck" AutomationProperties.AutomationId="TriStateCheck" Content="Three state option" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,0,12"/>
                        <Expander x:Name="AdvancedExpander" AutomationProperties.AutomationId="AdvancedExpander" Header="Advanced diagnostics" Margin="0,0,0,8"><Border Padding="12"><TextBlock Text="Expanded diagnostics content"/></Border></Expander>
                        <TreeView x:Name="DeepDiagnosticsTree" AutomationProperties.AutomationId="DeepDiagnosticsTree" Margin="0,0,0,12"><TreeViewItem x:Name="DeepRoot" AutomationProperties.AutomationId="DeepRoot" Header="Runtime"><TreeViewItem Header="IPC"><TreeViewItem Header="Named pipe"/></TreeViewItem><TreeViewItem Header="Visual tree"/></TreeViewItem></TreeView>
                        <Button x:Name="DisabledActionButton" AutomationProperties.AutomationId="DisabledActionButton" Content="Disabled action" IsEnabled="False" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Button x:Name="ResetFormButton" AutomationProperties.AutomationId="ResetFormButton" Content="Reset Form" Click="ResetForm_Click" Margin="0,0,8,0"/><Button x:Name="OpenPopupButton" AutomationProperties.AutomationId="OpenPopupButton" Content="Open Popup" Click="OpenPopup_Click"/></StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>

        <!-- Test Modal Window Overlay -->
        <Grid x:Name="TestModalOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="200"
              Visibility="Collapsed">
            <Border Background="#B0000000" MouseDown="CloseModal_Click"/>

            <Border Margin="30" Width="500" Height="280" CornerRadius="16" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Sample Modal Dialog" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Grid.Row="1" Text="This modal tests modal rendering, Z-index overlays, and input events across visual layers." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="CancelModalButton" AutomationProperties.AutomationId="CancelModalButton" Content="Cancel" Appearance="Secondary" Height="34" Margin="0,0,8,0" Click="CloseModal_Click"/>
                        <ui:Button x:Name="ConfirmModalBtn" AutomationProperties.AutomationId="ConfirmModalBtn" Content="Confirm Action" Appearance="Primary" Height="34" Click="ConfirmModal_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- History Drawer Overlay -->
        <Grid x:Name="TestDrawerOverlay"
              Grid.RowSpan="2"
              Panel.ZIndex="210"
              Visibility="Collapsed">
            <Border Background="#80000000" MouseDown="CloseDrawer_Click"/>

            <Border Width="380" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1,0,0,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Execution Log History" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel>
                            <TextBlock Text="• [15:28:01] Process Attached (PID 12480)" Margin="0,0,0,8" FontSize="12"/>
                            <TextBlock Text="• [15:28:05] Navigation Click: Collection View" Margin="0,0,0,8" FontSize="12"/>
                            <TextBlock Text="• [15:28:10] Screenshot Captured: 1100x720" Margin="0,0,0,8" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:Button x:Name="CloseDrawerButton" AutomationProperties.AutomationId="CloseDrawerButton" Grid.Row="2" Content="Close Drawer" Appearance="Secondary" Height="34" HorizontalAlignment="Right" Click="CloseDrawer_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Popup x:Name="InspectorPopup" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#252525" BorderBrush="#5A9BD5" BorderThickness="1" CornerRadius="8" Padding="16" Width="300">
                <StackPanel>
                    <TextBlock Text="Inspector Popup" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="This popup is a separate presentation surface." TextWrapping="Wrap" Margin="0,8,0,12"/>
                    <Button x:Name="ClosePopupButton" AutomationProperties.AutomationId="ClosePopupButton" Content="Close Popup" Click="ClosePopup_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
